# Backend environment configuration
# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — only the local frontend origin is allowed
CORS_ORIGIN=http://localhost:8080

# SQLite database file (relative to backend/ directory)
DATABASE_URL=sqlite:///./smartattendance.db

# Absolute paths to ML assets (adjust if your layout differs)
# Leave blank to use the default auto-detected paths relative to backend/
ML_EMBEDDINGS_PATH=
ML_YUNET_MODEL_PATH=
ML_SFACE_MODEL_PATH=

# Recognition cosine similarity threshold (must match the value in face_recognizer.py)
# DO NOT lower this without explicit approval.
COSINE_THRESHOLD=0.38

# Authentication & Security
# Set ENVIRONMENT=production in deployed environments
ENVIRONMENT=development
# Generate a cryptographically strong secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

